# Algoritmo de Conectividad Micelial (Optimización de Energía)
# Propósito: Seleccionar la ruta de datos con menor 'ruido' o resistencia.

class MotorMicelial:
    def __init__(self):
        self.activo = True

    def conectar_nodos(self, opciones_ruta):
        """
        Recibe una lista de caminos y elige el que tiene 
        el valor de resistencia más bajo (el más eficiente).
        """
        if not opciones_ruta:
            return "ESPERANDO_DATOS"
        
        # El micelio elige el camino que menos energía consume
        ruta_optima = min(opciones_ruta, key=lambda x: x.get('resistencia', 100))
        return ruta_optima

# El sistema ahora toma decisiones de ruta de forma automática
micelio = MotorMicelial()
