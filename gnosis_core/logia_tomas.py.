import json
import random
import os

class GranOraculoTomas:
    def __init__(self):
        self.ruta_biblioteca = 'gnosis_core/biblioteca_tomas.json'
        
    def consultar_fuente(self):
        """Lee la totalidad de los dichos desde la biblioteca JSON"""
        try:
            with open(self.ruta_biblioteca, 'r', encoding='utf-8') as f:
                datos = json.load(f)
                return datos['dichos']
        except:
            return {"0": "La fuente está fluyendo, intenta conectar de nuevo."}

    def revelar_sabiduria(self):
        """El azar divino elige una perla de la totalidad de la biblioteca"""
        biblioteca = self.consultar_fuente()
        numero_dicho = random.choice(list(biblioteca.keys()))
        return f"Dicho {numero_dicho}: {biblioteca[numero_dicho]}"

# El Gran Oráculo ahora tiene acceso a la Fuente completa
oraculo_total = GranOraculoTomas()
