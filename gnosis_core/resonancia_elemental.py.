            "Tecnología": "Velocidad de pensamiento y conexión global.",
            "Animales": "Instinto puro y presencia en el ahora."
        }
        return f"Sintonizando con {elemento}: {biblioteca_vibracional.get(elemento, 'Frecuencia desconocida')}"

